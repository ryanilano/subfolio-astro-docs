---
// Standalone hand-authored landing (D-01/D-04) — NOT a Starlight layout.
// Read the base once; every internal href/asset is built from it so it stays
// correct under the GitHub Pages base path (RESEARCH Pattern 1 / Pitfall 2).
import '../styles/tokens.css';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>subfolio-astro-docs</title>
		<style>
			/* Consumes the shared token layer (tokens.css) — no bespoke --bg/--fg/--link
			   and no ad-hoc blues; retired in favor of --color-* (D-01/D-04). */
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
			}
			body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				gap: var(--space-2);
				padding: var(--space-5) var(--space-3);
				background: var(--color-bg);
				color: var(--color-ink);
				font-family: var(--font-sans);
				font-size: var(--text-base);
				line-height: var(--leading);
			}
			@media (min-width: 640px) {
				body {
					padding: var(--space-5) var(--space-4);
				}
			}
			h1 {
				margin: 0;
				font-size: var(--text-h2);
				font-weight: 600;
				line-height: 1.2;
			}
			p {
				margin: 0;
			}
			a.cta {
				/* padding lifts the visible link to a 44px min tap target (UI-SPEC Spacing);
				   fixed tap-target minimum, not scalable body type. */
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				padding: var(--space-1) var(--space-2);
				color: var(--color-link);
				text-decoration: underline;
				text-underline-offset: 8px;
			}
		</style>
	</head>
	<body>
		<h1>subfolio-astro-docs</h1>
		<p>Documentation site — under construction.</p>
		<a class="cta" href={`${base}docs/`}>View the Docs</a>
	</body>
</html>
